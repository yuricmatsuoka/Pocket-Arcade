<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaco_pequeno"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textNumero"
        style="@style/Texto.Secundario"
        android:layout_width="32dp"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textDigito1"
        android:layout_width="@dimen/tamanho_digito"
        android:layout_height="@dimen/tamanho_digito"
        android:layout_marginEnd="@dimen/espaco_pequeno"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/textDigito2"
        android:layout_width="@dimen/tamanho_digito"
        android:layout_height="@dimen/tamanho_digito"
        android:layout_marginEnd="@dimen/espaco_pequeno"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/textDigito3"
        android:layout_width="@dimen/tamanho_digito"
        android:layout_height="@dimen/tamanho_digito"
        android:layout_marginEnd="@dimen/espaco_pequeno"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/textDigito4"
        android:layout_width="@dimen/tamanho_digito"
        android:layout_height="@dimen/tamanho_digito"
        android:layout_marginEnd="@dimen/espaco_pequeno"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:typeface="monospace" />
</LinearLayout>
