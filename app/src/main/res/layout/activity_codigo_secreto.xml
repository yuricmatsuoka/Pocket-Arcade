<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".CodigoSecretoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingVertical="@dimen/espaco_grande">

        <TextView
            android:id="@+id/textTitulo"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modulo_codigo" />

        <TextView
            android:id="@+id/textJogador"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:background="@drawable/bg_painel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <TextView
                android:id="@+id/textCofre"
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/codigo_cofre_fechado"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/textTentativas"
                style="@style/Texto.Corpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/apoio"
                android:textStyle="bold" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/codigo_instrucao" />

            <EditText
                android:id="@+id/editPalpite"
                style="@style/Campo.PocketArcade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:digits="0123456789"
                android:gravity="center"
                android:hint="@string/codigo_dica"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1"
                android:textSize="22sp" />

            <Button
                android:id="@+id/buttonTentar"
                style="@style/Botao.PocketArcade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/botao_tentar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/painelResultadoCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:background="@drawable/bg_painel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela"
            android:visibility="gone">

            <TextView
                android:id="@+id/textResultadoCodigo"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/destaque" />

            <TextView
                android:id="@+id/textDetalhesCodigo"
                style="@style/Texto.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:gravity="center" />

            <Button
                android:id="@+id/buttonNovaPartidaCodigo"
                style="@style/Botao.PocketArcade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/botao_nova_partida" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/legenda_certa"
            android:textColor="@color/pista_certa" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/legenda_posicao"
            android:textColor="@color/pista_posicao" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/legenda_ausente" />

        <TextView
            style="@style/Texto.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/codigo_historico_titulo"
            android:textColor="@color/destaque" />

        <TextView
            android:id="@+id/textHistoricoVazio"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/codigo_historico_vazio" />

        <LinearLayout
            android:id="@+id/containerHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonVoltar"
            style="@style/Botao.PocketArcade.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/botao_voltar" />

        <Button
            android:id="@+id/buttonEncerrarSessao"
            style="@style/Botao.PocketArcade.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/botao_encerrar_sessao" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
