<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".RandomizadorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingVertical="@dimen/espaco_medio">

        <TextView
            android:id="@+id/textTitulo"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modulo_randomizador" />

        <TextView
            android:id="@+id/textJogador"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <EditText
            android:id="@+id/editValor"
            style="@style/Campo.PocketArcade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:hint="@string/dica_valor"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerCategoria"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_botao"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:background="@drawable/bg_campo"
                android:contentDescription="@string/desc_spinner_categoria"
                android:entries="@array/categorias"
                android:paddingHorizontal="@dimen/espaco_pequeno"
                android:popupBackground="@color/card" />

            <Button
                android:id="@+id/buttonAdicionar"
                style="@style/Botao.PocketArcade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_adicionar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonSortear"
                style="@style/Botao.PocketArcade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_sortear" />

            <Button
                android:id="@+id/buttonAlternar"
                style="@style/Botao.PocketArcade.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_modo_grade" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/painelSorteio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:background="@drawable/bg_painel"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio"
            android:visibility="gone">

            <TextView
                android:id="@+id/textSorteado"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/destaque" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItens"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonVoltar"
                style="@style/Botao.PocketArcade.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_voltar" />

            <Button
                android:id="@+id/buttonEncerrarSessao"
                style="@style/Botao.PocketArcade.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_encerrar_sessao" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
