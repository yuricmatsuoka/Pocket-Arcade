<resources>
    <!-- Tema escuro único: Grafite e Limão -->
    <style name="Base.Theme.PocketArcade" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/destaque</item>
        <item name="colorOnPrimary">@color/fundo</item>
        <item name="colorSecondary">@color/apoio</item>
        <item name="android:windowBackground">@color/fundo</item>
    </style>

    <style name="Theme.PocketArcade" parent="Base.Theme.PocketArcade" />

    <!-- Textos -->
    <style name="Texto">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Texto.Titulo">
        <item name="android:textColor">@color/destaque</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Subtitulo">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Corpo" />

    <style name="Texto.Secundario">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Campos de texto -->
    <style name="Campo.PocketArcade" parent="">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_suave</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Botão principal: limão com texto grafite -->
    <style name="Botao.PocketArcade" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/destaque</item>
        <item name="android:textColor">@color/fundo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Botão secundário: contorno limão -->
    <style name="Botao.PocketArcade.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/destaque</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/altura_botao</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/destaque</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
